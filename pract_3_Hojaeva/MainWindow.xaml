<Window x:Class="pract_3_Hojaeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract_3_Hojaeva"
        mc:Ignorable="d"
        Title="Планирование встречи" Height="700" Width="1000">
    <DockPanel LastChildFill="True" Background="#d6ebe2">

        <Border DockPanel.Dock="Top" Padding="15" Background="#2C5545">
            <TextBlock FontSize="20" Foreground="White" >Планирование встречи</TextBlock>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="10">

            <DockPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="auto"/>
                    <Setter Property="Width" Value="auto"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                </Style>
            </DockPanel.Resources>

            <Button>Создать</Button>
            <Button>Сохранить черновик</Button>
            <Button>Отмена</Button>
        </DockPanel>

        <Border CornerRadius="5" Margin="15" Padding="5,10" Background="White">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="10,5,10,0"/>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="10,5,10,0"/>
                        </Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Margin" Value="10,5,10,0"/>
                        </Style>
                        <Style TargetType="DatePicker">
                            <Setter Property="Margin" Value="10,5,10,0"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0">Тема</TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0">Организатор</TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0">Переговорная</TextBlock>
                    <ComboBox Grid.Row="2" Grid.Column="1">
                        <ComboBoxItem>Комната 101</ComboBoxItem>
                        <ComboBoxItem>Комната 102</ComboBoxItem>
                        <ComboBoxItem>Комната 103</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0">Дата</TextBlock>
                    <DatePicker Grid.Row="3" Grid.Column="1"/>

                    <TextBlock Grid.Row="4" Grid.Column="0">Время начала</TextBlock>
                    <ComboBox Grid.Row="4" Grid.Column="1">
                        <ComboBoxItem>09:00</ComboBoxItem>
                        <ComboBoxItem>10:00</ComboBoxItem>
                        <ComboBoxItem>11:00</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="5" Grid.Column="0">Время окончания</TextBlock>
                    <ComboBox Grid.Row="5" Grid.Column="1">
                        <ComboBoxItem>10:00</ComboBoxItem>
                        <ComboBoxItem>11:00</ComboBoxItem>
                        <ComboBoxItem>12:00</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="2">Повестка</TextBlock>
                    <TextBox Grid.Row="2" Grid.RowSpan="6" Grid.Column="2" Margin="10,0,10,0"/>

                </Grid>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="10,5,20,0"/>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Margin" Value="20,5,10,0"/>
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0">Ссылка для подключения</TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" />

                    <TextBlock Grid.Row="1" Grid.Column="0">Количество участников</TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1"/>

                </Grid>

                <Grid Grid.Row="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,5,0,5" FontWeight="Bold">Участники</TextBlock>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <WrapPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Height" Value="auto"/>
                                <Setter Property="Width" Value="auto"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,5,5,5"/>
                                <Setter Property="CornerRadius" Value="3"/>
                                <Setter Property="Background" Value="#CBE9E1"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                            <Style TargetType="Button">
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="Width" Value="20"/>
                            </Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal"/>
                            </Style>
                        </WrapPanel.Resources>

                        <Border>
                            <StackPanel>
                                <TextBlock>Анна Смирнова</TextBlock>
                                <Button>×</Button>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock>Иван Петров</TextBlock>
                                <Button>×</Button>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock>Мария Орлова</TextBlock>
                                <Button>×</Button>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock>Алексей Волков</TextBlock>
                                <Button>×</Button>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock>Ольга Соколова</TextBlock>
                                <Button>×</Button>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock>Денис Крылов</TextBlock>
                                <Button>×</Button>
                            </StackPanel>
                        </Border>

                    </WrapPanel>

                    <StackPanel Grid.Row="2" Orientation="Vertical">

                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,5"/>
                            </Style>
                        </StackPanel.Resources>

                        <CheckBox>Отправить приглашение</CheckBox>
                        <CheckBox>Напомнить за 15 минут</CheckBox>

                    </StackPanel>

                </Grid>

            </Grid>
        </Border>

    </DockPanel>
</Window>
